<Project Sdk="Dalamud.NET.Sdk/13.1.0">
    <PropertyGroup>
        <Version>1.0.5.1</Version>
        <LangVersion>Preview</LangVersion>
        <DebugType>portable</DebugType>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\KamiToolKit\KamiToolKit.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <Content Include="Assets\**\*.png" CopyToOutputDirectory="Always"/>
        <Content Include="Localization\*.json" CopyToOutputDirectory="Always"/>
    </ItemGroup>

    <!-- Generate loc_en.json before build using PowerShell script -->
    <Target Name="GenerateLocalization" BeforeTargets="BeforeBuild">
        <Message Text="Generating loc_en.json from Strings.cs..." Importance="high"/>
        <Exec Command="pwsh -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\Tools\GenerateLocalization.ps1&quot; &quot;$(MSBuildProjectDirectory)\Localization\Strings.cs&quot; &quot;$(MSBuildProjectDirectory)\Localization\loc_en.json&quot;"
              IgnoreExitCode="false"
              ContinueOnError="false"
              Condition="Exists('$(MSBuildProjectDirectory)\Tools\GenerateLocalization.ps1')"/>
    </Target>
</Project>